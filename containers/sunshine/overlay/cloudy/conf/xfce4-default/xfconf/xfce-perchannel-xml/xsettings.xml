<?xml version="1.0" encoding="UTF-8"?>

<channel name="xsettings" version="1.0">
  <property name="Net" type="empty">
    <!-- Fluent GTK theme: matches xfwm4 ThemeName and Fluent-gtk-theme install -->
    <property name="ThemeName" type="string" value="Fluent-Dark"/>
    <!-- Fluent icon theme (rounded Windows 11 style, pairs with the GTK theme).
         Note: icon theme dir is lowercase "Fluent-dark" (see Fluent-icon-theme install.sh) -->
    <property name="IconThemeName" type="string" value="Fluent-dark"/>
  </property>
  <property name="Gtk" type="empty">
    <property name="FontName" type="string" value="Sans 10"/>
  </property>
</channel>