{
    "env": {
        "PATH": "$(PATH):$(HOME)\/.local\/bin"
    },
    "apps": [
        {
            "auto-detach": true,
            "cmd": [],
            "elevated": false,
            "exclude-global-prep-cmd": false,
            "exit-timeout": 5,
            "image-path": "desktop.png",
            "prep-cmd": [
                {
                    "do": "sh -c \"sunshine-app-startup.sh > \/tmp\/sunshine-session-start.log 2>&1\""
                }
            ],
            "name": "Desktop",
            "output": "",
            "wait-all": true
        },
        {
            "name": "Steam (Big Picture)",
            "image-path": "/cloudy/conf/sunshine/assets/steam-big-picture.png",
            "prep-cmd": [
                {
                    "do": "sh -c \"sunshine-app-startup.sh > \/tmp\/sunshine-session-start.log 2>&1\"",
                    "undo": "sh -c \"steam-stop.sh > \/tmp\/steam-stop.log 2>&1\""
                }
            ],
            "detached": [
                "sh -c \"steam-start.sh steam:\/\/open\/bigpicture > \/tmp\/steam-start-big-picture.log 2>&1\""
            ],
            "exclude-global-prep-cmd": "false",
            "auto-detach": "true",
            "wait-all": "true",
            "exit-timeout": "5",
            "cmd": ""
        }
    ]
}
