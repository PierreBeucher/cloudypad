[Unit]
# Keep the NVIDIA DRM card device open.
#
# On hosts with a headless NVIDIA GPU (eg. datacenter GPUs such as RTX 4000
# Ada on Linode), the nvidia_drm module tears itself down shortly after the
# last client closes the device ("Cannot find any crtc or sizes" followed by
# driver unload), making /dev/dri/cardN disappear from sysfs. Cloudy Pad's
# compositor and Sunshine capture need the DRM card to stay available.
# Holding the device open prevents the last-close teardown.
Description=Hold NVIDIA DRM card device open to prevent nvidia_drm module teardown
After=multi-user.target

[Service]
Type=simple
# Keep retrying: the card may not exist yet at boot (module load order) or
# may be temporarily unavailable during driver reloads
ExecStart=/usr/local/bin/nvidia-drm-hold.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target